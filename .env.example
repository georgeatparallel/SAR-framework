# Copy to .env and fill what your backend needs. `sar doctor` reports which of
# these are set and what is still missing.
#
# NOTE ON PREFIXES: AppConfig reads settings with the SAR_ prefix
# (env_prefix="SAR_" in src/sar/config.py). The LLM client additionally falls
# back to a bare OPENAI_API_KEY, which is why that one works unprefixed --
# nothing else does. Prefer the prefixed spelling everywhere.

# --- Model backend ----------------------------------------------------------
# "openai" (hosted API) or "codex" (local Codex CLI)
SAR_LLM_BACKEND=openai

# openai backend. The bare name is honoured for backward compatibility.
OPENAI_API_KEY=
# SAR_OPENAI_API_KEY=
# SAR_OPENAI_MODEL_FAST=gpt-4o-mini

# codex backend — model slug passed to `codex exec --model`
SAR_CODEX_MODEL=gpt-5.6-terra

# --- Search backends --------------------------------------------------------
# Keyless backends (DuckDuckGo, Wikipedia, CrossRef, Semantic Scholar, arXiv,
# PubMed) need nothing. The two below are registered ONLY when set, so leaving
# them blank silently narrows every search rather than failing.
SAR_BRAVE_API_KEY=
SAR_UNPAYWALL_EMAIL=
# Raises Semantic Scholar's rate limit; optional.
SAR_SEMANTIC_SCHOLAR_API_KEY=

# Which backends the web layer queries. The CLI uses its own default set.
# SAR_SEARCH_BACKENDS=semantic_scholar,crossref,brave

# --- Content fetching -------------------------------------------------------
# With FETCH_CONTENT off, the reader sees only backend snippets and every
# extracted claim comes from a few hundred characters rather than the document.
SAR_FETCH_CONTENT=true
# Headless-browser rendering for JS-heavy pages. Needs `playwright install
# chromium`; turn off if browser binaries are unavailable.
SAR_FETCH_USE_PLAYWRIGHT=true
SAR_CACHE_DB_PATH=data/cache.db
SAR_URL_CACHE_TTL_DAYS=7

# --- Run limits and output --------------------------------------------------
SAR_AUDIT_LOG_DIR=data/audit_logs
# SAR_MAX_ITERATIONS=3
# SAR_QUALITY_THRESHOLD=6.0
# SAR_BUDGET_CEILING_USD=5.0
